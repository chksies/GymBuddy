# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=gymbuddy_db

# JWT - signs everyone's logins. Use a long random value.
JWT_SECRET=change-me-to-a-long-random-value

# Photos (check-ins and profile pictures) are stored in MongoDB and served at /api/media/<id>;
# nothing to configure. To use S3-compatible storage instead, set AWS_S3_BUCKET and the rest below.
# Works with AWS S3 as-is. For Cloudflare R2 / DigitalOcean Spaces / MinIO, also
# set AWS_S3_ENDPOINT_URL to that provider's endpoint.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=
# Optional: a CDN domain or provider-specific public URL in front of the bucket.
# If unset, URLs are built as https://{bucket}.s3.{region}.amazonaws.com/{key}
# (or {AWS_S3_ENDPOINT_URL}/{bucket}/{key} when an endpoint is set).
AWS_S3_PUBLIC_URL_BASE=

# With S3, the bucket must allow public GetObject (a bucket policy, not ACLs - AWS
# disables object ACLs by default on new buckets) since photos are loaded by URL.
