# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=gymbuddy_db

# JWT - set a real random secret in production; there is no safe default
JWT_SECRET=change-me-to-a-long-random-value

# Image storage for check-in photos / profile pictures.
# Leave AWS_S3_BUCKET empty and photos are saved on disk in backend/uploads (or UPLOAD_DIR)
# and served by the API itself - nothing else to set up. Set a bucket to use S3 instead.
# Works with AWS S3 as-is. For Cloudflare R2 / DigitalOcean Spaces / MinIO, also
# set AWS_S3_ENDPOINT_URL to that provider's endpoint.
# UPLOAD_DIR=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=
# Optional: a CDN domain or provider-specific public URL in front of the bucket.
# If unset, URLs are built as https://{bucket}.s3.{region}.amazonaws.com/{key}
# (or {AWS_S3_ENDPOINT_URL}/{bucket}/{key} when an endpoint is set).
AWS_S3_PUBLIC_URL_BASE=

# The bucket must allow public GetObject (a bucket policy, not ACLs - AWS
# disables object ACLs by default on new buckets) since posted images are
# served directly by URL to the friend feed.
